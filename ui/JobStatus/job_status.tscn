[node name="Job" type="Control" parent="."]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="ActivityProgress" type="ProgressBar" parent="Job"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
show_percentage = false
theme_override_styles/background = SubResource("StyleBoxEmpty_job_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_job_fill")

[node name="ActivityLabel" type="Label" parent="Job"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
vertical_alignment = 1
text_overrun_behavior = 3
