[gd_scene format=3]

[ext_resource type="Script" path="res://ui/JobStatus/job_status.gd" id="1_job"]
[ext_resource type="Texture2D" path="res://icons/cross.svg" id="2_cancel"]

[sub_resource type="LabelSettings" id="LabelSettings_job"]
font_color = Color(1, 1, 1, 0.3372549)

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_job_bg"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_job_fill"]
bg_color = Color(0.7, 0.8, 1, 0.12)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="JobStatus" type="HBoxContainer"]
visible = false
size_flags_horizontal = 3
