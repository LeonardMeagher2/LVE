[gd_scene format=3]

[ext_resource type="Script" path="res://ui/palette_panel.gd" id="1_palette"]

[node name="PalettePanel" type="VBoxContainer"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
theme_override_constants/separation = 4
script = ExtResource("1_palette")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="SwatchGrid" type="GridContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
columns = 8
theme_override_constants/h_separation = 3
theme_override_constants/v_separation = 3

[node name="AddColor" type="Button" parent="."]
custom_minimum_size = Vector2(0, 26)
layout_mode = 2
focus_mode = 0
text = "Add Color"

[node name="ColorPicker" type="ColorPicker" parent="."]
layout_mode = 2
size_flags_vertical = 3

[node name="RecentColors" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 3

[connection signal="pressed" from="AddColor" to="." method="_on_add_color_pressed"]
[connection signal="color_changed" from="ColorPicker" to="." method="_on_picker_color_changed"]
