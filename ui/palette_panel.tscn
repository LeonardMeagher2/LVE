[gd_scene format=3]

[ext_resource type="Script" path="res://ui/palette_panel.gd" id="1_palette"]
[ext_resource type="PackedScene" path="res://ui/color_picker.tscn" id="2_picker"]

[node name="PalettePanel" type="VBoxContainer"]
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
theme_override_constants/separation = 4
script = ExtResource("1_palette")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="SwatchGrid" type="GridContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
columns = 8
theme_override_constants/h_separation = 3
theme_override_constants/v_separation = 3

[node name="ColorPicker" parent="." instance=ExtResource("2_picker")]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[connection signal="color_changed" from="ColorPicker" to="." method="_on_picker_color_changed"]
