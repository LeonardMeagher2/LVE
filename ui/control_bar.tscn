[ext_resource type="Texture2D" uid="uid://bhg85sqfio31d" path="res://icons/grid.svg" id="2_grid"]
[ext_resource type="Texture2D" uid="uid://mglj26s40ce4" path="res://icons/center.svg" id="3_center"]
[ext_resource type="Texture2D" uid="uid://dif3h4ri2n0me" path="res://icons/camera.svg" id="4_camera"]
[ext_resource type="Texture2D" uid="uid://cubut3i22m2q4" path="res://icons/hand.svg" id="5_pan"]
[ext_resource type="Texture2D" uid="uid://dy2x8ri5jrac1" path="res://icons/rotate.svg" id="6_rotate"]
[ext_resource type="Texture2D" path="res://icons/zoom.svg" id="7_zoom"]

[sub_resource type="ButtonGroup" id="ButtonGroup_left_mode"]
allow_unpress = true

[node name="ControlBar" type="HBoxContainer" unique_id=53784703]
custom_minimum_size = Vector2(0, 28)
theme_override_constants/separation = 6
script = ExtResource("1_control")

[node name="CameraMenu" type="MenuButton" parent="." unique_id=1053028430]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "View"
focus_mode = 2
icon = ExtResource("4_camera")
flat = false
icon_alignment = 1

[node name="PanToggle" type="Button" parent="." unique_id=1802399301]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Pan mode: left-drag pans the view"
toggle_mode = true
button_group = SubResource("ButtonGroup_left_mode")
icon = ExtResource("5_pan")
icon_alignment = 1

[node name="RotateToggle" type="Button" parent="." unique_id=422170048]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Rotate mode: left-drag orbits the view"
toggle_mode = true
button_group = SubResource("ButtonGroup_left_mode")
icon = ExtResource("6_rotate")
icon_alignment = 1

[node name="ZoomIcon" type="TextureRect" parent="." unique_id=2116463353]
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Zoom"
texture = ExtResource("7_zoom")

[node name="ZoomSlider" type="HSlider" parent="." unique_id=1393546872]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
tooltip_text = "Zoom"
min_value = 1.0
max_value = 400.0
value = 100.0

[node name="ZoomOne" type="Button" parent="." unique_id=954156555]
layout_mode = 2
tooltip_text = "Return the zoom to 100 percent"
text = "1:1"
icon_alignment = 1

[node name="CenterBtn" type="Button" parent="." unique_id=567890123]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Center the selection, or the whole model, in the view"
icon = ExtResource("3_center")
icon_alignment = 1

[node name="GridToggle" type="Button" parent="." unique_id=1396369045]
layout_mode = 2
tooltip_text = "Toggle the grid"
toggle_mode = true
button_pressed = true
icon = ExtResource("2_grid")
icon_alignment = 1

[connection signal="value_changed" from="ZoomSlider" to="." method="_on_zoom_slider_changed"]
[connection signal="pressed" from="ZoomOne" to="." method="_on_zoom_one_pressed"]
[connection signal="toggled" from="GridToggle" to="." method="_on_grid_toggled"]
