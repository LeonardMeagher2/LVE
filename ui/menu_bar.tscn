[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menu_bar.gd" id="1_menu"]

[node name="MenuBar" type="HBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 6
script = ExtResource("1_menu")

[node name="File" type="MenuButton" parent="."]
layout_mode = 2
text = "File"
item_count = 5
popup/item_0/text = "New"
popup/item_0/id = 0
popup/item_1/text = "Open..."
popup/item_1/id = 1
popup/item_2/text = "Save"
popup/item_2/id = 2
popup/item_3/text = "Save As..."
popup/item_3/id = 3
popup/item_4/text = "Quit"
popup/item_4/id = 4

[node name="Edit" type="MenuButton" parent="."]
layout_mode = 2
text = "Edit"
item_count = 2
popup/item_0/text = "Undo"
popup/item_0/id = 0
popup/item_1/text = "Redo"
popup/item_1/id = 1

[node name="View" type="MenuButton" parent="."]
layout_mode = 2
text = "View"
item_count = 2
popup/item_0/text = "Reset View"
popup/item_0/id = 0
popup/item_1/text = "Toggle Grid"
popup/item_1/id = 1

[node name="MenuSpacer" type="Control" parent="."]
layout_mode = 2
