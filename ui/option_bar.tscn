[gd_scene format=3]

[ext_resource type="Script" path="res://ui/option_bar.gd" id="1_option"]
[ext_resource type="Texture2D" path="res://icons/pixel_perfect.svg" id="2_pp"]

[node name="OptionBar" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_override_constants/separation = 6
script = ExtResource("1_option")

[node name="PixelPerfect" type="CheckButton" parent="."]
layout_mode = 2
focus_mode = 0
icon = ExtResource("2_pp")
text = "Pixel Perfect"
tooltip_text = "Toggle voxel snapping of the ghost preview"

[node name="View" type="MenuButton" parent="."]
layout_mode = 2
focus_mode = 0
text = "View"
item_count = 5
popup/item_0/text = "Top"
popup/item_0/id = 0
popup/item_1/text = "Front"
popup/item_1/id = 1
popup/item_2/text = "Side"
popup/item_2/id = 2
popup/item_3/text = "Isometric"
popup/item_3/id = 3
popup/item_4/text = "Reset"
popup/item_4/id = 4

[node name="OptionSpacer" type="Control" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[connection signal="toggled" from="PixelPerfect" to="." method="_on_pixel_perfect_toggled"]
