[node name="View" type="OptionButton" parent="Panels/SheetPanel/Margin/Sheet/Settings/ViewRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SizeRow" type="HBoxContainer" parent="Panels/SheetPanel/Margin/Sheet/Settings"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Label" type="Label" parent="Panels/SheetPanel/Margin/Sheet/Settings/SizeRow"]
layout_mode = 2
text = "Size"

[node name="Size" type="SpinBox" parent="Panels/SheetPanel/Margin/Sheet/Settings/SizeRow"]
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 2048.0
value = 1.0
suffix = "px"
