[node name="Frames" type="OptionButton" parent="Panels/SheetPanel/Margin/Sheet/Settings/FrameRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ViewRow" type="HBoxContainer" parent="Panels/SheetPanel/Margin/Sheet/Settings"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Label" type="TextureRect" parent="Panels/SheetPanel/Margin/Sheet/Settings/ViewRow"]
