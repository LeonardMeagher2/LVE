[node name="Reset" type="Button" parent="Panels/SheetPanel/Margin/Sheet/Settings/SizeRow"]
layout_mode = 2
tooltip_text = "Use the shared projected bounds for automatic frame spacing"
icon = ExtResource("6_reset")
icon_alignment = 1

[node name="TurntableRow" type="HBoxContainer" parent="Panels/SheetPanel/Margin/Sheet/Settings"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Turntable" type="CheckBox" parent="Panels/SheetPanel/Margin/Sheet/Settings/TurntableRow"]
layout_mode = 2
size_flags_horizontal = 3
button_pressed = true
text = "Turntable"
tooltip_text = "Export each frame from evenly spaced views around the Y axis."

[node name="Views" type="SpinBox" parent="Panels/SheetPanel/Margin/Sheet/Settings/TurntableRow"]
layout_mode = 2
min_value = 2.0
max_value = 64.0
value = 8.0
suffix = "views"

[node name="Metadata" type="CheckBox" parent="Panels/SheetPanel/Margin/Sheet/Settings/TurntableRow"]
layout_mode = 2
button_pressed = true
text = "JSON"
tooltip_text = "Include Aseprite-style frame rectangles, delays, and tags."

[node name="LightingOptions" type="HBoxContainer" parent="Panels/SheetPanel/Margin/Sheet"]
layout_mode = 2

[node name="Enabled" type="Button" parent="Panels/SheetPanel/Margin/Sheet/LightingOptions"]
layout_mode = 2
toggle_mode = true
button_pressed = true
icon = ExtResource("11_light")
icon_alignment = 1
tooltip_text = "Enable lighting. Disable this to export without shading."

[node name="LightColor" type="ColorPickerButton" parent="Panels/SheetPanel/Margin/Sheet/LightingOptions"]
custom_minimum_size = Vector2(32, 24)
layout_mode = 2
size_flags_horizontal = 3
color = Color(1, 1, 1, 1)
tooltip_text = "Light color. Alpha controls the strength."

[node name="AmbientColor" type="ColorPickerButton" parent="Panels/SheetPanel/Margin/Sheet/LightingOptions"]
custom_minimum_size = Vector2(32, 24)
layout_mode = 2
size_flags_horizontal = 3
color = Color(0.54901963, 0.5686275, 0.61960787, 1)
tooltip_text = "Ambient color. Alpha controls the strength."

[node name="Shadows" type="CheckBox" parent="Panels/SheetPanel/Margin/Sheet/LightingOptions"]
layout_mode = 2
button_pressed = true
text = "Shadows"

[node name="LockView" type="Button" parent="Panels/SheetPanel/Margin/Sheet/LightingOptions"]
layout_mode = 2
toggle_mode = true
icon = ExtResource("14_lock")
icon_alignment = 1
tooltip_text = "Keep the light direction fixed relative to the view during rotation and turntable rendering."

[node name="Reset" type="Button" parent="Panels/SheetPanel/Margin/Sheet/LightingOptions"]
layout_mode = 2
tooltip_text = "Restore the default lighting"
icon = ExtResource("6_reset")
icon_alignment = 1

[node name="Export" type="Button" parent="Panels/SheetPanel/Margin/Sheet"]
layout_mode = 2
text = "PNG"
tooltip_text = "Export the sprite sheet as a PNG image"
