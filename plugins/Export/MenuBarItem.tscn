[gd_scene format=3]

[ext_resource type="Texture2D" path="res://icons/export_gltf.svg" id="1_export"]

[node name="ExportMenuItem" type="HBoxContainer"]

[node name="ExportBtn" type="Button" parent="."]
layout_mode = 2
tooltip_text = "Export"
toggle_mode = true
icon = ExtResource("1_export")
icon_alignment = 1

[node name="ExportDialog" type="FileDialog" parent="."]
title = "Export as glTF"
file_mode = 4
access = 2
filters = PackedStringArray("*.glb ; Binary glTF", "*.gltf ; glTF JSON")

[node name="SpriteSheetDialog" type="FileDialog" parent="."]
title = "Export Sprite Sheet"
file_mode = 4
access = 2
filters = PackedStringArray("*.png ; PNG sprite sheet")
