[gd_scene format=3]

[ext_resource type="ButtonGroup" uid="uid://tm4elm05vye0" path="res://plugins/ToolBarButtonGroup.tres" id="1_bg"]
[ext_resource type="Texture2D" uid="uid://vfhvhh7m0svp" path="res://icons/fill.svg" id="2_icon"]

[sub_resource type="InputEventAction" id="InputEventAction_fill"]
action = &"tool_fill"
pressed = true

[sub_resource type="Shortcut" id="Shortcut_fill"]
resource_name = "Fill"
events = [SubResource("InputEventAction_fill")]

[node name="fill" type="Button"]
tooltip_text = "Fill matching voxels with a color"
toggle_mode = true
button_group = ExtResource("1_bg")
shortcut = SubResource("Shortcut_fill")
icon = ExtResource("2_icon")
icon_alignment = 1
