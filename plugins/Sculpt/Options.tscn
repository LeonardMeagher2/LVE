[gd_scene format=3]

[ext_resource type="Script" path="res://plugins/Sculpt/Options.gd" id="1_script"]
[ext_resource type="PackedScene" uid="uid://kxi223occ3vl" path="res://ui/ValueButton/ValueButton.tscn" id="2_value"]
[ext_resource type="Texture2D" path="res://icons/mode_add.svg" id="3_add"]
[ext_resource type="Texture2D" path="res://icons/mode_subtract.svg" id="4_remove"]
[ext_resource type="Texture2D" path="res://icons/brush_diameter.svg" id="5_radius"]
[ext_resource type="Texture2D" path="res://icons/spray_rate.svg" id="6_strength"]
[ext_resource type="Texture2D" path="res://icons/shadow.svg" id="7_falloff"]
[ext_resource type="Texture2D" path="res://icons/sculpt_surface.svg" id="8_surface"]

[sub_resource type="ButtonGroup" id="GrowGroup"]

[node name="Options" type="HBoxContainer"]
script = ExtResource("1_script")

[node name="Grow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Add" type="Button" parent="Grow"]
layout_mode = 2
tooltip_text = "Grow outward"
toggle_mode = true
button_group = SubResource("GrowGroup")
icon = ExtResource("3_add")
icon_alignment = 1

[node name="Remove" type="Button" parent="Grow"]
layout_mode = 2
tooltip_text = "Cut inward"
toggle_mode = true
button_group = SubResource("GrowGroup")
icon = ExtResource("4_remove")
icon_alignment = 1

[node name="Normal" type="Button" parent="."]
layout_mode = 2
tooltip_text = "Surface normal: fit the plane to nearby voxels. Press for the exact face."
toggle_mode = true
icon = ExtResource("8_surface")
icon_alignment = 1

[node name="Radius" parent="." instance=ExtResource("2_value")]
layout_mode = 2
tooltip_text = "Sculpt radius in voxels."
icon = ExtResource("5_radius")
min_value = 1.0
max_value = 32.0
step = 1.0
decimals = 0
value = 4.0

[node name="Strength" parent="." instance=ExtResource("2_value")]
layout_mode = 2
tooltip_text = "Sculpt strength in voxel steps per application."
icon = ExtResource("6_strength")
min_value = 0.1
max_value = 16.0
step = 0.1
decimals = 1
value = 1.0

[node name="Falloff" parent="." instance=ExtResource("2_value")]
layout_mode = 2
tooltip_text = "Sculpt edge falloff. Zero is a hard edge and one is a smooth edge."
icon = ExtResource("7_falloff")
min_value = 0.0
max_value = 1.0
step = 0.05
decimals = 2
value = 0.5

[connection signal="toggled" from="Normal" to="." method="_on_normal_toggled"]
[connection signal="pressed" from="Grow/Add" to="." method="_on_add_pressed"]
[connection signal="pressed" from="Grow/Remove" to="." method="_on_remove_pressed"]
[connection signal="value_changed" from="Radius" to="." method="_on_radius_changed"]
[connection signal="value_changed" from="Strength" to="." method="_on_strength_changed"]
[connection signal="value_changed" from="Falloff" to="." method="_on_falloff_changed"]
