; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Leonard's Voxel Editor"
config/description="Made with LVE. Create voxel art and animation."
config/version="0.2"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

State="*res://Globals/State/State.gd"
VoxelImageRenderer="*res://Globals/VoxelImageRenderer/VoxelImageRenderer.gd"

[display]

window/size/viewport_width=1000
window/size/viewport_height=800
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor]

naming/scene_name_casing=1
naming/script_name_casing=1

[gui]

theme/custom="uid://cfbvk6vpaexfm"

