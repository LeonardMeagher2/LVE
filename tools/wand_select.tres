[gd_resource type="Resource" script_class="ToolInfo" format=3 uid="uid://cguh2je3df5uk"]

[ext_resource type="Script" uid="uid://cjerda0p540dt" path="res://tools/tool_info.gd" id="1_script"]
[ext_resource type="Texture2D" uid="uid://dnpfta4guqhvd" path="res://icons/wand.svg" id="2_icon"]
[ext_resource type="Script" uid="uid://psmrld84nlu7" path="res://tools/tool_option.gd" id="3_mode"]
[ext_resource type="Script" uid="uid://psmrld84nlu7" path="res://tools/tool_option.gd" id="4_option"]

[sub_resource type="Resource" id="Resource_opt"]
script = ExtResource("3_mode")
id = "mode"
label = "selection mode"
default = "replace"
option_scene = "res://tools/select/mode_picker.tscn"

[sub_resource type="Resource" id="Resource_con"]
script = ExtResource("4_option")
id = "connected"
label = "connected"
default = true
option_scene = "res://tools/connected.tscn"

[sub_resource type="Resource" id="Resource_eps"]
script = ExtResource("4_option")
id = "color_epsilon"
label = "Color tolerance"
default = 0.0
option_scene = "res://tools/tolerance.tscn"

[resource]
script = ExtResource("1_script")
id = "wand"
display_name = "Wand"
icon = ExtResource("2_icon")
tooltip = "Select matching voxels of a color"
group = "select"
tool_scene = "res://tools/wand_select/wand_select.tscn"
options = [SubResource("Resource_opt"), SubResource("Resource_con"), SubResource("Resource_eps")]
