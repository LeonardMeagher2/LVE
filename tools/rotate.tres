[gd_resource type="Resource" script_class="ToolInfo" format=3]

[ext_resource type="Script" path="res://tools/tool_info.gd" id="1_script"]
[ext_resource type="Texture2D" uid="uid://dy2x8ri5jrac1" path="res://ui/Viewport/rotate.svg" id="2_icon"]
[ext_resource type="Script" path="res://tools/tool_option.gd" id="3_opt"]
[ext_resource type="PackedScene" path="res://tools/rotate/snap.tscn" id="4_snap"]
[ext_resource type="PackedScene" path="res://tools/commit_cancel.tscn" id="5_commit"]

[sub_resource type="Resource" id="Resource_snap"]
script = ExtResource("3_opt")
id = "snap"
label = "snap to 90 degrees"
default = false
option_scene = "res://tools/rotate/snap.tscn"

[sub_resource type="Resource" id="Resource_commit"]
script = ExtResource("3_opt")
id = "commit"
label = "commit transform"
option_scene = "res://tools/commit_cancel.tscn"

[resource]
script = ExtResource("1_script")
id = "rotate"
display_name = "Rotate"
group = "transform"
tooltip = "Rotate the selection"
tool_scene = "res://tools/rotate/rotate.tscn"
icon = ExtResource("2_icon")
options = [SubResource("Resource_snap"), SubResource("Resource_commit")]
